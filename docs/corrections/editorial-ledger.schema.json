{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded accepted-content editorial correction ledger",
  "description": "Separate from expansion and rejected-candidate reopening. Strict semantic/hash invariants in validate-round.mjs and editorial-ledger.mjs are mandatory.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ledgerSchemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "accepted_content_editorial"
    },
    "campaignId": {
      "const": "2026-exam-final"
    },
    "correctionRoundId": {
      "type": "string",
      "minLength": 1
    },
    "prdVersion": {
      "const": "1.9"
    },
    "timezone": {
      "const": "Asia/Seoul"
    },
    "status": {
      "enum": [
        "running",
        "closed"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "decisionDeadline": {
      "type": "string",
      "format": "date-time"
    },
    "closedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxCycles": {
          "const": 3
        },
        "maxRoundHours": {
          "const": 4
        },
        "newKnowledgeItems": {
          "const": 0
        }
      },
      "required": [
        "maxCycles",
        "maxRoundHours",
        "newKnowledgeItems"
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "bankVersion": {
          "type": "string",
          "minLength": 1
        },
        "bankSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "regularWrittenBySubject": {
          "$ref": "#/$defs/subjectCounts"
        },
        "regularPractical": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "sourceCommit",
        "bankVersion",
        "bankSha256",
        "regularWrittenBySubject",
        "regularPractical"
      ]
    },
    "changedQuestionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "changedOptionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "changedPracticalChoiceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "corrections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/correction"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registered": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "newRegular": {
          "const": 0
        },
        "revisedRegular": {
          "type": "integer",
          "minimum": 0
        },
        "publishedRevisedRegular": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "registered",
        "accepted",
        "rejected",
        "pending",
        "newRegular",
        "revisedRegular",
        "publishedRevisedRegular"
      ]
    },
    "coverageAfter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regularWrittenBySubject": {
          "$ref": "#/$defs/subjectCounts"
        },
        "regularPractical": {
          "type": "integer",
          "minimum": 0
        },
        "mockEligible": {
          "type": "boolean"
        }
      },
      "required": [
        "regularWrittenBySubject",
        "regularPractical",
        "mockEligible"
      ]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not_attempted",
            "skipped",
            "blocked",
            "committed_unverified",
            "verified"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        },
        "bankVersion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "bankSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "pattern": "^https?://"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "commit",
        "bankVersion",
        "bankSha256",
        "verifiedAt",
        "url",
        "blockers"
      ]
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "reportPath": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "check",
          "result",
          "summary",
          "reportPath"
        ]
      }
    },
    "nextAction": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "ledgerSchemaVersion",
    "kind",
    "campaignId",
    "correctionRoundId",
    "prdVersion",
    "timezone",
    "status",
    "startedAt",
    "decisionDeadline",
    "closedAt",
    "policy",
    "baseline",
    "changedQuestionIds",
    "changedOptionIds",
    "changedPracticalChoiceIds",
    "corrections",
    "counts",
    "coverageAfter",
    "publication",
    "validation",
    "nextAction",
    "summary"
  ],
  "$defs": {
    "subjectCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "s1": {
          "type": "integer",
          "minimum": 0
        },
        "s2": {
          "type": "integer",
          "minimum": 0
        },
        "s3": {
          "type": "integer",
          "minimum": 0
        },
        "s4": {
          "type": "integer",
          "minimum": 0
        },
        "s5": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "s1",
        "s2",
        "s3",
        "s4",
        "s5"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "rights": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sourceId",
        "title",
        "url",
        "version",
        "location",
        "checkedAt",
        "summary",
        "rights"
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "reviewerId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "result",
        "reviewerId",
        "summary",
        "evidenceRefs"
      ]
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cycle": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blindSolve": {
              "$ref": "#/$defs/gate"
            },
            "sourceCheck": {
              "$ref": "#/$defs/gate"
            },
            "ambiguityCheck": {
              "$ref": "#/$defs/gate"
            },
            "authoringAccessibility": {
              "$ref": "#/$defs/gate"
            },
            "structuralCheck": {
              "$ref": "#/$defs/gate"
            }
          },
          "required": [
            "blindSolve",
            "sourceCheck",
            "ambiguityCheck",
            "authoringAccessibility",
            "structuralCheck"
          ]
        },
        "outcome": {
          "enum": [
            "running",
            "accepted",
            "revise",
            "rejected"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "blindPackageSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewPackagePath": {
          "type": "string",
          "pattern": "^docs/corrections/evidence/[^/]+-cycle-[123]\\.json$"
        },
        "reviewPackageSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "componentStates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "written_option",
                  "practical_choice"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "contentSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "kind",
              "id",
              "revision",
              "contentSha256"
            ]
          }
        }
      },
      "required": [
        "cycle",
        "revision",
        "startedAt",
        "finishedAt",
        "gates",
        "outcome",
        "summary",
        "contentSha256",
        "blindPackageSha256",
        "reviewPackagePath",
        "reviewPackageSha256",
        "componentStates"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "gates": {
                "properties": {
                  "blindSolve": {
                    "properties": {
                      "result": {
                        "const": "pass"
                      },
                      "reviewerId": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "sourceCheck": {
                    "properties": {
                      "result": {
                        "const": "pass"
                      },
                      "reviewerId": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "ambiguityCheck": {
                    "properties": {
                      "result": {
                        "const": "pass"
                      },
                      "reviewerId": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "authoringAccessibility": {
                    "properties": {
                      "result": {
                        "const": "pass"
                      },
                      "reviewerId": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "structuralCheck": {
                    "properties": {
                      "result": {
                        "const": "pass"
                      },
                      "reviewerId": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cycle": {
                "const": 3
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "running",
                  "accepted",
                  "rejected"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "running"
              }
            }
          },
          "then": {
            "properties": {
              "finishedAt": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "finishedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "revisionChange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "beforeRevision": {
          "type": "integer",
          "minimum": 1
        },
        "afterRevision": {
          "type": "integer",
          "minimum": 1
        },
        "beforeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "afterSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "beforeRevision",
        "afterRevision",
        "beforeSha256",
        "afterSha256"
      ]
    },
    "acceptedRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roundId": {
          "type": "string",
          "minLength": 1
        },
        "candidateId": {
          "type": "string",
          "minLength": 1
        },
        "ledgerPath": {
          "type": "string",
          "minLength": 1
        },
        "bankVersion": {
          "type": "string",
          "minLength": 1
        },
        "bankSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "questionRevision": {
          "type": "integer",
          "minimum": 1
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "roundId",
        "candidateId",
        "ledgerPath",
        "bankVersion",
        "bankSha256",
        "questionRevision",
        "contentSha256"
      ]
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "correctionId": {
          "type": "string",
          "minLength": 1
        },
        "issueId": {
          "type": "string",
          "minLength": 1
        },
        "questionId": {
          "type": "string",
          "minLength": 1
        },
        "templateId": {
          "type": "string",
          "minLength": 1
        },
        "learningGoalId": {
          "type": "string",
          "minLength": 1
        },
        "learningGoalRevision": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "written",
            "practical"
          ]
        },
        "subjectId": {
          "enum": [
            "s1",
            "s2",
            "s3",
            "s4",
            "s5",
            "practical"
          ]
        },
        "priorAcceptedRef": {
          "$ref": "#/$defs/acceptedRef"
        },
        "defect": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "authorId": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "optionChanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revisionChange"
          }
        },
        "practicalChoiceChanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revisionChange"
          }
        },
        "attemptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "cycles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cycle"
          },
          "maxItems": 3
        },
        "decision": {
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ]
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "decisionSummary": {
          "type": "string",
          "minLength": 1
        },
        "publishedBankVersion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "targetPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/(questions|options)/",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "correctionId",
        "issueId",
        "questionId",
        "templateId",
        "learningGoalId",
        "learningGoalRevision",
        "type",
        "subjectId",
        "priorAcceptedRef",
        "defect",
        "revision",
        "authorId",
        "evidence",
        "optionChanges",
        "practicalChoiceChanges",
        "attemptCount",
        "cycles",
        "decision",
        "reasonCodes",
        "decisionSummary",
        "publishedBankVersion",
        "targetPaths"
      ]
    }
  }
}
